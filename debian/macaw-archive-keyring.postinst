#!/bin/sh
set -e

#DEBHELPER#

# Earlier installs pointed the source at a key copied to /etc/apt/keyrings.
# Point it at the keyring this package keeps current, and drop the copy.
sources=/etc/apt/sources.list.d/macaw.sources
old=/etc/apt/keyrings/macaw.gpg
new=/usr/share/keyrings/macaw-archive-keyring.gpg
if [ "$1" = configure ] && [ -f "$sources" ] && grep -q "^Signed-By: $old\$" "$sources"; then
	sed -i "s|^Signed-By: $old\$|Signed-By: $new|" "$sources"
	rm -f "$old"
fi

# Without this, systems with i386 enabled (Steam, Wine) get a notice on every
# apt update that the repository has no i386 packages.
if [ "$1" = configure ] && [ -f "$sources" ] && ! grep -q "^Architectures:" "$sources"; then
	sed -i "s|^Components: main\$|&\nArchitectures: amd64|" "$sources"
fi

exit 0
