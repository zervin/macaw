#!/bin/sh
set -e

#DEBHELPER#

# dh_installsystemduser enables the user unit but never restarts it, so an
# upgrade, or a swap from another myna-server package (a fresh install of
# this one), would leave the old server running until the next login. Reload
# and restart it, only where it is already running, in each user's manager.
if [ "$1" = "configure" ] && [ -z "${DPKG_ROOT:-}" ] && command -v loginctl >/dev/null; then
	for user in $(loginctl list-users --no-legend 2>/dev/null | awk '{print $2}'); do
		systemctl --user -M "$user@" daemon-reload >/dev/null 2>&1 || true
		systemctl --user -M "$user@" --no-block try-restart myna-server.service >/dev/null 2>&1 || true
	done
fi

exit 0
